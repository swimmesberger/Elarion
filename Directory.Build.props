<Project>
  <PropertyGroup>
    <!-- Every runtime package targets the current LTS (net10.0) and the current release (net11.0): apps that
         cannot move yet keep a supported line, while net11 apps get assets compiled against the .NET 11 surface
         (in-box Microsoft.Extensions abstractions, .NET 11 package majors, runtime async). Package versions
         that differ per framework are conditioned in Directory.Packages.props. Source code compiles for both,
         so it is limited to C# 14 unless guarded with #if NET11_0_OR_GREATER. Generator projects (*.Generators)
         are excluded: they target netstandard2.0 (the Roslyn analyzer host) with a singular TargetFramework, which
         the bundling packages need — a multi-targeting outer build has no GetTargetPath for them to call, and an
         inherited TargetFrameworks next to a singular TargetFramework would make restore and build disagree. -->
    <ElarionTargetFrameworks>net10.0;net11.0</ElarionTargetFrameworks>
    <TargetFrameworks Condition="!$(MSBuildProjectName.EndsWith('.Generators'))">$(ElarionTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VersionPrefix>0.3.3</VersionPrefix>
    <Authors>Simon Wimmesberger</Authors>
    <Company>swimmesberger</Company>
    <Copyright>Copyright (c) Simon Wimmesberger</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://elarion.wimmesberger.dev</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/swimmesberger/Elarion.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>elarion;json-rpc;mcp;source-generator;roslyn;dotnet;aspnetcore;clean-architecture;cqrs;ai-agents</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Link="README.md"/>
    <None Include="$(MSBuildThisFileDirectory)docs/public/brand/elarion-nuget-icon.png" Pack="true" PackagePath="icon.png" Visible="false"/>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all"/>
  </ItemGroup>
</Project>
