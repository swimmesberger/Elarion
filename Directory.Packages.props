<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5"/>
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.5"/>
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5"/>
    <!-- Transitive security pins (GHSA-qhrr-8q5h-9q3h, GHSA-846f-f764-76mx): Aspire.Hosting 13.5.x pulls MessagePack 2.5.302 and
         BenchmarkDotNet 0.15.x pulls System.Security.Cryptography.Pkcs 9.0.4. Samples/benchmarks only; drop once upstream catches up. -->
    <PackageVersion Include="MessagePack" Version="2.5.307"/>
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15"/>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0"/>
    <!-- tests/Elarion.Benchmarks only. A preview: 0.15.x does not recognize net11.0 (the runtime async comparison
         runs on it); return to a stable release once one supports .NET 11. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2"/>
    <PackageVersion Include="BenchmarkDotNet.Diagnostics.dotTrace" Version="0.16.0-preview.2"/>
    <!-- Bulk-insert benchmark competitors (tests/Elarion.Benchmarks only, never a src/ dependency).
         Deliberately the MIT fork of EFCore.BulkExtensions — the upstream package is revenue-gated dual-license. -->
    <PackageVersion Include="EFCore.BulkExtensions.MIT.PostgreSql" Version="10.22.0"/>
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1"/>
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.85.0"/>
    <PackageVersion Include="Grpc.Core.Api" Version="2.85.0"/>
    <PackageVersion Include="linq2db.EntityFrameworkCore" Version="10.7.0"/>
    <PackageVersion Include="PhenX.EntityFrameworkCore.BulkInsert.PostgreSql" Version="0.5.0"/>
    <!-- SQL row-mapping benchmark competitors (ADR-0058 gate; tests/Elarion.Benchmarks only, never a src/ dependency). -->
    <PackageVersion Include="Dapper" Version="2.1.89"/>
    <PackageVersion Include="Dapper.AOT" Version="1.1.0"/>
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1"/>
    <!-- The EF Core stack stays on 10.x for both target frameworks: EF Core 11 needs the matching Npgsql provider
         (Npgsql.EntityFrameworkCore.PostgreSQL 11 is still a release candidate), and EF Core 10 runs on .NET 11.
         Move these (and Identity.EntityFrameworkCore, which depends on EF Core Relational of its own major) into the
         per-framework groups below once the provider ships. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15"/>
    <!-- Generator Roslyn floor: match the compiler of the oldest SDK band consumers may build with (10.0.3xx = Roslyn 5.6),
         not the repository's own global.json SDK (11.0.1xx = Roslyn 5.12). A newer Microsoft.CodeAnalysis.CSharp makes the
         bundled generators fail to load (CS9057) for consumers on an older SDK; raise it only when that support floor moves.
         C# 15 unions are recognisable without a newer Roslyn API: they carry System.Runtime.CompilerServices.UnionAttribute. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0"/>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.Caching.Postgres" Version="1.2.2"/>
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/>
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0"/>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100"/>
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0"/>
    <PackageVersion Include="Npgsql" Version="10.0.3"/>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3"/>
    <PackageVersion Include="OpenFeature" Version="2.14.1"/>
    <PackageVersion Include="OpenFeature.Hosting" Version="2.14.1"/>
    <PackageVersion Include="OpenFeature.Contrib.Provider.FeatureManagement" Version="0.1.2-preview"/>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0"/>
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0"/>
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0"/>
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0"/>
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0"/>
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3"/>
  </ItemGroup>
  <!-- Packages that ship on the .NET release train resolve to the major of the target framework being built
       (Directory.Build.props builds every runtime package for net10.0 and net11.0). Matching majors keep a net11
       consumer from receiving assets compiled against the .NET 10 surface — in particular Microsoft.OpenApi (2.x on
       net10, 3.x on net11, where Microsoft.AspNetCore.OpenApi 11 requires it) and the Microsoft.Extensions.Validation
       surface the generated validation resolvers compile against. On net11 the Microsoft.Extensions abstractions are
       part of the shared framework, so those references are pruned there (no NU1510 while net10 is also targeted). -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <!-- Keep Microsoft.OpenApi at or above Microsoft.AspNetCore.OpenApi's floor (10.0.15 requires [2.13.0, 3.0.0); GHSA-v5pm-xwqc-g5wc is fixed in 2.7.5).
         Stay on the 2.x line here: Microsoft.AspNetCore.OpenApi 10's XML-comment source generator assigns
         IOpenApiMediaType.Example, which 3.x made read-only (CS0200). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0"/>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15"/>
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.11.0"/>
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0"/>
    <PackageVersion Include="Microsoft.Extensions.Validation" Version="10.0.15"/>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <!-- Microsoft.AspNetCore.OpenApi 11 requires Microsoft.OpenApi [3.11.0, 4.0.0). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0"/>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Validation" Version="11.0.0"/>
  </ItemGroup>
</Project>
