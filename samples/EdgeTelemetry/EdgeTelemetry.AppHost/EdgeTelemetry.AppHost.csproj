<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.4"/>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <!-- Persists Aspire's generated parameter values (the postgres password) across runs;
         without it, WithDataVolume breaks on the second run — the volume keeps the first
         password while every new run generates a fresh one, so the database health check
         never passes and WaitFor-gated projects never start. -->
    <UserSecretsId>4a706f20-6bae-486c-8d02-ab5136697016</UserSecretsId>
    <Description>EdgeTelemetry sample — .NET Aspire orchestration: provisions TimescaleDB and runs the API.</Description>
    <!-- The repo default (Directory.Build.props) disables reflection-based JSON for framework/AOT
         hygiene, but Aspire.Hosting's orchestrator (DCP dependency check) deserializes with
         reflection — the AppHost is dev orchestration tooling, so turn it back on here. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Aspire.AppHost.Sdk defaults AspireUseCliBundle to false (DCP/dashboard come from NuGet), while
         Aspire.Hosting.AppHost 13.5+ warns about that default. The sample runs with plain `dotnet run`
         and does not need the Aspire CLI bundle. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost"/>
    <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EdgeTelemetry.Api\EdgeTelemetry.Api.csproj"/>
  </ItemGroup>

</Project>
