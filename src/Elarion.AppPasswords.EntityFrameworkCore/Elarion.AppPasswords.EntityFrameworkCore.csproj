<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>EF Core-backed app-password store for Elarion (ADR-0111): the elarion_app_passwords table (the SHA-256 of each secret under a unique index, never the secret) on the database the application already runs, mapped onto its own DbContext through [GenerateElarionAppPasswords] or modelBuilder.UseElarionAppPasswords(). Change-tracker-free writes; the per-user cap and the last-use throttle hold across nodes.</Description>
    <PackageTags>elarion;app-passwords;caldav;entity-framework-core;postgresql;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elarion.AppPasswords\Elarion.AppPasswords.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elarion.Tests"/>
  </ItemGroup>

  <!-- Bundle the source generator's analyzer into this package. NuGet analyzer assets are not
       transitive, so the generator lives in the package each annotated assembly references directly.
       ReferenceOutputAssembly=false keeps it off the runtime surface; PrivateAssets=all keeps it from
       becoming a downstream package dependency. -->
  <ItemGroup>
    <ProjectReference Include="..\Elarion.AppPasswords.EntityFrameworkCore.Generators\Elarion.AppPasswords.EntityFrameworkCore.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
  </ItemGroup>

  <Target Name="_BundleElarionAppPasswordsGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Elarion.AppPasswords.EntityFrameworkCore.Generators\Elarion.AppPasswords.EntityFrameworkCore.Generators.csproj"
             Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_ElarionAppPasswordsGeneratorAnalyzer"/>
    </MSBuild>
    <ItemGroup>
      <None Include="@(_ElarionAppPasswordsGeneratorAnalyzer)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs/"
            Visible="false"/>
    </ItemGroup>
  </Target>

</Project>
