<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>CardDAV for Elarion (ADR-0113): address-book sources (ordinary query handlers that decide who sees which address book), ICardDavPublisher publishing Elarion.Contacts contacts into the published-collection store in the handler's transaction, and the address-book properties and reports (addressbook-multiget, addressbook-query with prop-filter, param-filter and text-match) on the WebDAV core, as vCard 3.0 or 4.0, read-only for iOS, macOS, Thunderbird, DAVx5 and Evolution. No ASP.NET Core, no EF Core, no reflection.</Description>
    <PackageTags>elarion;carddav;webdav;contacts;vcard;rfc6352;sync;dotnet</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- AddElarionCardDav(IConfiguration) binds through the configuration-binding source generator, not the reflection binder. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Elarion.WebDav/Elarion.WebDav.csproj"/>
    <ProjectReference Include="../Elarion.Contacts/Elarion.Contacts.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elarion.Tests"/>
  </ItemGroup>

</Project>
