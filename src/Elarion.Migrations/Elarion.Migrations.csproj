<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Database-neutral migration plan (ADR-0060, ADR-0081): SQL scripts (embedded V{version}__/R__ discovery, SHA-256 checksums over line-ending-normalized content) and C# ICodeMigration steps — and, through Elarion.Migrations.EntityFrameworkCore, EF Core migrations — merged into one version-ordered sequence with one history table and one exclusive lock. Out-of-order and repeatable planning, satisfied/baseline adoption, and the roll-forward execution model (a step's history row commits with its transaction — no repair command, no failed-row limbo). Drives a database provider through the IMigrationDatabase seam and the neutral AddElarionMigrations over an IMigrationDatabaseFactory a provider registers (Elarion.Sql.PostgreSql, Elarion.Sql.Sqlite). NativeAOT-compatible; contains no database driver and no EF reference.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elarion.Sql.PostgreSql"/>
    <InternalsVisibleTo Include="Elarion.Sql.Sqlite"/>
    <InternalsVisibleTo Include="Elarion.Tests"/>
  </ItemGroup>

</Project>
