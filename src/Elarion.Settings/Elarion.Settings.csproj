<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Runtime-changeable settings for Elarion: declared setting definitions resolved through one layered resolver, a swappable key/value store with in-process change notification (the sink side) and an AOT-clean typed accessor (the consuming side), supporting global and per-user scopes, secrets protected at rest, and deployment-configuration pinning.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elarion.Abstractions\Elarion.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Elarion.Abstractions"/>
    <Using Include="Elarion.Abstractions.Settings"/>
  </ItemGroup>

</Project>
