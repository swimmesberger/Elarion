<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Entity Framework Core source-generation markers and opt-in model conventions for Elarion applications.</Description>
  </PropertyGroup>

  <!-- The opt-in value-shape conventions (ElarionValueComparers, HasElarionJsonStringArray,
       UseElarionEnumStringConversions) configure a real ModelBuilder, so this package carries EF Core itself.
       The provider-neutral base package is deliberate: nothing here touches a provider API. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
  </ItemGroup>

  <!-- Bundle the EF Core source generator's analyzer into this marker package. NuGet analyzer assets
       are not transitive, so shipping the generator inside the package that a configuration assembly
       already references (the [EntityConfiguration] marker package) makes the marker reference
       self-sufficient: any assembly that declares [EntityConfiguration]/[GenerateDbSets] types emits its
       manifest without a separate analyzer package. ReferenceOutputAssembly=false keeps the generator off
       the runtime surface; PrivateAssets=all keeps it from becoming a downstream package dependency. -->
  <ItemGroup>
    <ProjectReference Include="..\Elarion.EntityFrameworkCore.Generators\Elarion.EntityFrameworkCore.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
  </ItemGroup>

  <Target Name="_BundleEntityFrameworkCoreGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Elarion.EntityFrameworkCore.Generators\Elarion.EntityFrameworkCore.Generators.csproj"
             Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_EntityFrameworkCoreGeneratorAnalyzer"/>
    </MSBuild>
    <ItemGroup>
      <None Include="@(_EntityFrameworkCoreGeneratorAnalyzer)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs/"
            Visible="false"/>
    </ItemGroup>
  </Target>

</Project>
