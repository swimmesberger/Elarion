<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>vCard contacts for Elarion (ADR-0110): ContactReader reads .vcf files of vCard 2.1, 3.0 and 4.0 from any common producer leniently into contacts, with every property kept in a lossless list and every error coded and located; ContactWriter writes contacts as vCard 3.0 or 4.0, deterministically and forward-only. No reflection and no third-party library, so an application keeps publishing with NativeAOT.</Description>
    <PackageTags>elarion;contacts;vcard;vcf;rfc6350;import;export;dotnet</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- AddElarionContacts(IConfiguration) binds through the configuration-binding source generator, not the reflection binder. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Elarion.Abstractions/Elarion.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <!-- The content-line layer shared with Elarion.Calendars (ADR-0110, decision 2): internal, compiled into both. -->
  <ItemGroup>
    <Compile Include="..\Shared\ContentLines\**\*.cs" LinkBase="ContentLines"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elarion.Tests"/>
  </ItemGroup>

</Project>
