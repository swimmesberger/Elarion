<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Implementation-neutral blob storage contracts for Elarion applications, including the protocol-neutral staged (resumable) upload seam with its in-memory default, the provider-neutral garbage collectors, and the owner-checked reader that hands staged uploads to handlers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <!-- For IUploadedFiles (the handler-side reader of staged uploads): its contract, Result/AppError and
         ICurrentUser live in the contracts package, like the other provider-neutral cores reference it. -->
    <ProjectReference Include="..\Elarion.Abstractions\Elarion.Abstractions.csproj"/>
  </ItemGroup>

</Project>
