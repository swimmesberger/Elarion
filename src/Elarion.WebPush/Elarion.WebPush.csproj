<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Web Push for Elarion (RFC 8030/8291/8292, ADR-0076): VAPID key management (configuration → store → generate, race-safe), the IPushSubscriptionStore seam with an in-memory default, and IWebPushSender — aes128gcm encryption and VAPID signing on the .NET crypto primitives, bounded fan-out, and cleanup of subscriptions the push service reports gone. No third-party push SDK.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elarion.Abstractions\Elarion.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Http"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elarion.Tests"/>
  </ItemGroup>

</Project>
