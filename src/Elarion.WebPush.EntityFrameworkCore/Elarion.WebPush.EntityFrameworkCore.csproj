<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>EF Core-backed Web Push stores for Elarion (ADR-0076): the elarion_push_subscriptions table (upsert-by-endpoint that reassigns a re-subscribed device) and the elarion_vapid_keys table (race-safe first-use key generation across nodes) on the one PostgreSQL the app already runs, mapped through [GenerateElarionWebPush] or modelBuilder.UseElarionWebPush().</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elarion.WebPush\Elarion.WebPush.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elarion.Tests"/>
  </ItemGroup>

  <!-- Bundle the source generator's analyzer into this package. NuGet analyzer assets are not
       transitive, so the generator lives in the package each annotated assembly references directly.
       ReferenceOutputAssembly=false keeps it off the runtime surface; PrivateAssets=all keeps it from
       becoming a downstream package dependency. -->
  <ItemGroup>
    <ProjectReference Include="..\Elarion.WebPush.EntityFrameworkCore.Generators\Elarion.WebPush.EntityFrameworkCore.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
  </ItemGroup>

  <Target Name="_BundleElarionWebPushGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Elarion.WebPush.EntityFrameworkCore.Generators\Elarion.WebPush.EntityFrameworkCore.Generators.csproj"
             Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_ElarionWebPushGeneratorAnalyzer"/>
    </MSBuild>
    <ItemGroup>
      <None Include="@(_ElarionWebPushGeneratorAnalyzer)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs/"
            Visible="false"/>
    </ItemGroup>
  </Target>

</Project>
