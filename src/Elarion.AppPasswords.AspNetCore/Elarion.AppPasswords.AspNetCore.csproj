<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The ASP.NET Core authentication scheme for Elarion app passwords (ADR-0111): HTTP Basic for calendar apps and a feed token in the feed URL's path, with events to replace the credential check, check the user name, create the principal on every request and observe a success; a 401 Basic challenge and a 403 without one. AddElarionIdentityAppPasswordPrincipals&lt;TUser&gt;() creates the principal through ASP.NET Core Identity. Hand-written, no reflection.</Description>
    <PackageTags>elarion;app-passwords;caldav;webdav;authentication;basic-auth;aspnetcore;dotnet</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elarion.AppPasswords\Elarion.AppPasswords.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elarion.Tests"/>
  </ItemGroup>

</Project>
