<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>App passwords for Elarion (ADR-0111): IAppPasswords issues a per-user, named, scoped credential for calendar apps and feeds (a prefix plus 256 bits from the CSPRNG, returned once, stored only as its SHA-256), lists and revokes them, and verifies a secret with a throttled last-use write; the IAppPasswordStore seam takes the EF store or the application's own. BCL cryptography only, no reflection.</Description>
    <PackageTags>elarion;app-passwords;caldav;webdav;authentication;dotnet</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- AddElarionAppPasswords(IConfiguration) binds through the configuration-binding source generator, not the reflection binder. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Elarion.Abstractions/Elarion.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elarion.Tests"/>
  </ItemGroup>

</Project>
