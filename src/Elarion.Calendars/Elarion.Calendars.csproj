<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>iCalendar files for Elarion (ADR-0109): CalendarReader reads .ics files leniently into events and to-dos with every error coded and located, keeps every property other programs wrote in a lossless component tree, resolves time zones and expands recurrences within a window; CalendarWriter writes calendars and feeds deterministically. No reflection and no third-party library, so an application keeps publishing with NativeAOT.</Description>
    <PackageTags>elarion;calendar;icalendar;ics;rfc5545;recurrence;import;export;dotnet</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- AddElarionCalendars(IConfiguration) binds through the configuration-binding source generator, not the reflection binder. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Elarion.Abstractions/Elarion.Abstractions.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <!-- The content-line layer shared with Elarion.Contacts (ADR-0109, decision 2): internal, compiled into both. -->
  <ItemGroup>
    <Compile Include="..\Shared\ContentLines\**\*.cs" LinkBase="ContentLines"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elarion.Tests"/>
  </ItemGroup>

</Project>
